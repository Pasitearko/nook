<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>nook</vendor>
  <action id="local.nook.readvolume">
    <description>Read NTFS file tables for the file-name index</description>
    <message>Authentication is required to read the file table and change journal of an NTFS partition (read-only) for the nook search index.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/nook/nook-volume-helper</annotate>
  </action>
  <action id="local.nook.readvolume.setup">
    <description>Allow nook to read NTFS file tables without a password</description>
    <message>Administrator authentication is required to let nook read NTFS partitions (read-only) at login without asking again.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/nook/nook-volume-setup</annotate>
  </action>
</policyconfig>
