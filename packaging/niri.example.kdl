// Optional: merge into your own niri configuration after testing.
// Installing nook never applies these rules automatically.
// Nook paints its own translucent surface, so keep the window itself fully opaque:
// a global "opacity 0.9" rule would also fade text and icons. The blur is clipped to the
// app's 12 px corners instead of showing square edges behind them.
window-rule {
    match app-id="^local\.nook(\.chooser|\.archive)?$"
    opacity 1.0
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
        blur true
        xray false
    }
}
// The Open/Save dialogs other applications show through the portal: a floating window.
window-rule {
    match app-id="^local\.nook\.chooser$"
    open-floating true
    default-column-width { fixed 1102; }
    default-window-height { fixed 709; }
}
// nook解压缩: floating. No fixed size: its windows ask for their own (the package window
// 1102×709, the compression window and the small progress window much less).
window-rule {
    match app-id="^local\.nook\.archive$"
    open-floating true
}
// Optional bind; replace an existing Mod+E instead of defining it twice.
// binds { Mod+E { spawn "nook" "--new-window"; } }
