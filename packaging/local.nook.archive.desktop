Categories=Utility;Archiving;Compression;
Keywords=zip;7z;rar;tar;压缩;解压;archive;
MimeType=application/zip;application/x-zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-gtar;application/x-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lz4-compressed-tar;application/x-lzma-compressed-tar;application/x-lzip-compressed-tar;application/x-tarz;application/gzip;application/x-gzip;application/x-bzip2;application/x-bzip;application/bzip2;application/x-xz;application/zstd;application/x-lzma;application/x-lz4;application/x-lzip;application/x-compress;application/x-gzpostscript;application/x-cpio;application/x-sv4cpio;application/x-sv4crc;application/vnd.efi.iso;application/x-iso9660-image;application/x-cd-image;application/vnd.ms-cab-compressed;application/vnd.debian.binary-package;application/x-deb;application/x-archive;application/x-rpm;application/x-source-rpm;application/x-xar;application/x-lha;application/x-lhz;application/x-arj;application/java-archive;application/x-java-archive;application/vnd.android.package-archive;application/x-ms-wim;application/x-apple-diskimage;application/vnd.squashfs;
StartupWMClass=local.nook.archive
StartupNotify=true
