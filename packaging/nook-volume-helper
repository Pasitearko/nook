#!/usr/bin/python3 -I
"""Open one NTFS partition read-only for the nook name index and hand the descriptor back.

Invoked only as: pkexec /usr/lib/nook/nook-volume-helper <NTFS-UUID>
with standard output connected to a Unix socket. The descriptor is passed with SCM_RIGHTS and
the helper exits; the index parses $MFT and the USN journal unprivileged. Nothing is written,
and only partitions carrying an NTFS boot sector are opened. Importing has no side effects.
"""
import os
import pwd
import re
import socket
import stat
import sys

HELPER = "/usr/lib/nook/nook-volume-helper"
BY_UUID = "/dev/disk/by-uuid"
UUID_RE = re.compile(r"[0-9A-F]{16}\Z")
GREETING = b"NOOK-VOLUME 1\n"


class Rejected(Exception):
    pass


def require_trusted(st, directory=False):
    valid_kind = stat.S_ISDIR(st.st_mode) if directory else stat.S_ISREG(st.st_mode)
    if not valid_kind or st.st_uid != 0 or st.st_mode & 0o022:
        raise Rejected("Expected a root-owned, non-writable trusted " + ("directory." if directory else "file."))


def check_installation(argv):
    if os.getuid() != 0 or os.geteuid() != 0:
        raise Rejected("This helper must be invoked as root by pkexec.")
    if len(argv) != 2 or os.path.abspath(argv[0]) != HELPER:
        raise Rejected("Only the installed helper may be invoked, with one volume UUID.")
    for path in ("/", "/usr", "/usr/lib", "/usr/lib/nook"):
        require_trusted(os.lstat(path), directory=True)
    require_trusted(os.lstat(HELPER))
    raw = os.environ.get("PKEXEC_UID", "")
    if not re.fullmatch(r"[1-9][0-9]{0,9}", raw):
        raise Rejected("Missing or invalid polkit caller identity.")
    try:
        pwd.getpwuid(int(raw))
    except (KeyError, OverflowError) as exc:
        raise Rejected("Polkit caller does not exist.") from exc
    return canonical_uuid(argv[1])


def canonical_uuid(value):
    value = value.upper()
    if not UUID_RE.match(value):
        raise Rejected("An NTFS volume UUID has 16 hexadecimal digits.")
    return value


def is_ntfs(boot):
    return len(boot) >= 512 and boot[3:11] == b"NTFS    " and boot[510:512] == b"\x55\xaa"


def resolve_device(uuid, by_uuid=BY_UUID):
    path = os.path.realpath(os.path.join(by_uuid, uuid))
    if not path.startswith("/dev/") or not stat.S_ISBLK(os.stat(path).st_mode):
        raise Rejected("No block device has this UUID.")
    return path


def open_volume(uuid, by_uuid=BY_UUID):
    path = resolve_device(uuid, by_uuid)
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NOCTTY)
    try:
        st = os.fstat(fd)
        # The opened device must be the one the UUID resolved to (no swap in between).
        if not stat.S_ISBLK(st.st_mode) or st.st_rdev != os.stat(path).st_rdev:
            raise Rejected("Device changed while opening.")
        if not is_ntfs(os.pread(fd, 512, 0)):
            raise Rejected("Not an NTFS partition.")
        return fd
    except BaseException:
        os.close(fd)
        raise


def hand_over(fd, output=1):
    channel = socket.socket(fileno=os.dup(output))
    try:
        if channel.family != socket.AF_UNIX:
            raise Rejected("Standard output must be a Unix socket.")
        socket.send_fds(channel, [GREETING], [fd])
    finally:
        channel.close()


def main(argv):
    os.umask(0o077)
    try:
        uuid = check_installation(argv)
        fd = open_volume(uuid)
        try:
            hand_over(fd)
        finally:
            os.close(fd)
        return 0
    except (Rejected, OSError, ValueError) as exc:
        print("nook-volume-helper: " + str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
